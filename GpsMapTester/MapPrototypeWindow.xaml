<Window x:Class="GpsMapTester.MapPrototypeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
        Title="DevExpress Map · OSM 래스터 + 벡터" Height="820" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <dxm:MapControl x:Name="Map" ZoomLevel="14">

            <!-- ① OSM 래스터 (온라인). DevExpress 내장 제공자 -->
            <dxm:ImageLayer x:Name="OsmLayer">
                <dxm:ImageLayer.DataProvider>
                    <dxm:OpenStreetMapDataProvider/>
                </dxm:ImageLayer.DataProvider>
            </dxm:ImageLayer>

            <!-- ② 시군구 경계 오버레이 (벡터, 반투명) -->
            <dxm:VectorLayer x:Name="LayerSigungu"
                             ShapeFill="#22000000" ShapeStroke="#663A6EA5"
                             EnableHighlighting="True" HighlightShapeFill="#332F80ED"
                             ToolTipEnabled="True" ToolTipPattern="{}{NL_NAME_2} ({NAME_2})">
                <dxm:VectorLayer.Data>
                    <dxm:ShapefileDataAdapter x:Name="AdSigungu"/>
                </dxm:VectorLayer.Data>
            </dxm:VectorLayer>

            <!-- ③ 마커 -->
            <dxm:VectorLayer>
                <dxm:VectorLayer.Data>
                    <dxm:MapItemStorage x:Name="MarkerStorage"/>
                </dxm:VectorLayer.Data>
            </dxm:VectorLayer>
        </dxm:MapControl>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="14,10"
                CornerRadius="10" Background="#E6202429" BorderBrush="#33FFFFFF" BorderThickness="1">
            <StackPanel MinWidth="320">
                <TextBlock Text="DevExpress Map" Foreground="White" FontWeight="Bold" FontSize="15"/>
                <TextBlock Text="① OSM 래스터(온라인) + ② 시군구 벡터 오버레이" Foreground="#C8CDD3" FontSize="12" Margin="0,6,0,0"/>
                <TextBlock Text="내장 제공자: OSM · MBTiles(오프라인) · Bing · Mapbox · WMS · Shapefile" Foreground="#9AA0A6" FontSize="12" Margin="0,2,0,0"/>
                <TextBlock Text="드래그 이동 · 휠 배율 · 테마 네이티브 통합" Foreground="#9AA0A6" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
