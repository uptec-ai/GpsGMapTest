<UserControl
    x:Class="GpsMapTester.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dxm="http://schemas.devexpress.com/winfx/2008/xaml/map"
    xmlns:ViewModels="clr-namespace:GpsMapTester.ViewModels"
    xmlns:conv="clr-namespace:GpsMapTester.Converters"
    mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="1000">

    <UserControl.DataContext>
        <ViewModels:MainViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA0A6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
        </Style>

        <conv:ScaleNegConverter x:Key="ScaleNeg"/>

        <!-- 포인트 마커: 라벨(전경색/배경색) + 포인트 점.
             콘텐츠 하단중앙이 좌표에 오도록 RenderTransform 으로 앵커 보정. -->
        <DataTemplate x:Key="MarkerLabelTemplate">
            <Grid x:Name="MarkerRoot">
                <Grid.RenderTransform>
                    <TranslateTransform
                        X="{Binding ActualWidth,  ElementName=MarkerRoot, Converter={StaticResource ScaleNeg}, ConverterParameter=0.5}"
                        Y="{Binding ActualHeight, ElementName=MarkerRoot, Converter={StaticResource ScaleNeg}, ConverterParameter=1}"/>
                </Grid.RenderTransform>
                <StackPanel HorizontalAlignment="Center">
                    <Border CornerRadius="8" Padding="10,4" HorizontalAlignment="Center"
                            Background="#F2FFFFFF" BorderBrush="#59000000" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding}" Foreground="Black" FontWeight="Bold" FontSize="13"
                                   FontFamily="Malgun Gothic, Segoe UI"/>
                    </Border>
                    <Border Height="3"/>
                    <Ellipse Width="16" Height="16" Fill="#FFC62828" Stroke="White" StrokeThickness="3"
                             HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#FFE9E5DE">
        <!-- ─── DevExpress Map · OSM 래스터 · 배율 12 고정 · follow ─────── -->
        <!-- OSM 래스터 레이어는 code-behind 에서 생성(디자이너 네트워크 차단 이미지 방지 + UA 설정).
             마커 저장소만 XAML 에 둔다. -->
        <dxm:MapControl x:Name="Map" ZoomLevel="12" EnableRotation="False">
            <dxm:VectorLayer>
                <dxm:VectorLayer.Data>
                    <dxm:MapItemStorage x:Name="MarkerStorage"/>
                </dxm:VectorLayer.Data>
            </dxm:VectorLayer>
        </dxm:MapControl>

        <!-- ─── 상태 오버레이 (좌상단) ─────────────────────────────────── -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16" Padding="16,12"
                CornerRadius="10" Background="#E6202429"
                BorderBrush="#33FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
            </Border.Effect>
            <StackPanel MinWidth="260">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#9AA0A6"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Connected">
                                        <Setter Property="Fill" Value="#34C759"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Searching">
                                        <Setter Property="Fill" Value="#FF9F0A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ConnectionState}" Value="Disconnected">
                                        <Setter Property="Fill" Value="#FF453A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatusText}"
                               Foreground="White" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>

                <Separator Margin="0,10" Background="#33FFFFFF"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="지역" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RegionLabel}" Style="{StaticResource FieldValue}" FontFamily="Segoe UI, Malgun Gothic"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="위도 (Lat)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatitudeText}" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="경도 (Lng)" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LongitudeText}" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Fix" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FixText}" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="위성 수" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SatelliteCountText}" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="속도" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SpeedText}" Style="{StaticResource FieldValue}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ─── 배율/소스 표시 (우하단) ────────────────────────────────── -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="16" Padding="10,5"
                CornerRadius="6" Background="#E6202429">
            <TextBlock x:Name="ZoomLabel" Foreground="#CCFFFFFF" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
